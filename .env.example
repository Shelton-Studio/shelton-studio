# ===================== Cerebro (Claude) =====================
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ===================== Motor de imagen =====================
# comfyui = GPU real | mock = modo prueba sin GPU (para probar la interfaz)
IMAGE_ENGINE=comfyui
COMFYUI_URL=http://127.0.0.1:8188
# Solo si tu ComfyUI está detrás de un proxy con token
COMFYUI_TOKEN=
COMFYUI_TIMEOUT=600

# Plantillas (carpeta app/comfyui/workflows o ruta absoluta a tu propio workflow exportado en "API format")
WORKFLOW_GENERATE=z_image_turbo.json
WORKFLOW_EDIT=qwen_image_edit.json
WORKFLOW_SUBJECT=qwen_subject.json

# Z-Image Turbo (generación). En GPUs de 6-8 GB usa la versión GGUF:
#   WORKFLOW_GENERATE=z_image_turbo_gguf.json  GEN_UNET=z_image_turbo-Q4_K_M.gguf  GEN_SCALE=0.75
GEN_UNET=z_image_turbo_bf16.safetensors
GEN_CLIP=qwen_3_4b.safetensors
GEN_VAE=ae.safetensors
GEN_STEPS=9
GEN_SCALE=1.0

# Qwen-Image-Edit 2509 (edición y banco de modelos)
EDIT_UNET=qwen_image_edit_2509_fp8_e4m3fn.safetensors
EDIT_CLIP=qwen_2.5_vl_7b_fp8_scaled.safetensors
EDIT_VAE=qwen_image_vae.safetensors
EDIT_LORA=Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors
EDIT_STEPS=4

# ===================== Cadena de producción =====================
QA_MIN_SCORE=70        # nota mínima del juez (por debajo reintenta; nunca borra)
QA_MAX_RETRIES=2       # reintentos por imagen
WORKERS=3              # posts en paralelo (la GPU procesa de a uno)
CONTENT_LANGUAGE=es

# ===================== Publicación =====================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===================== App =====================
APP_HOST=127.0.0.1
APP_PORT=8000
# DATA_DIR=./data
