# =====================================================================
#  Shelton Studio — configuración. Copia este archivo a .env
#  Casi todo también se puede configurar desde la web (Conexiones, Marca, Ajustes).
# =====================================================================

# ---------- Cerebro (Claude) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Plan B: OpenRouter. Se usa SOLO si ANTHROPIC_API_KEY está vacío.
# Modelo recomendado: uno de Claude (ve imágenes y usa herramientas). Lista: openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ---------- Motor de imagen y video (LOCAL) ----------
# comfyui = tu GPU | mock = modo demo sin GPU
IMAGE_ENGINE=comfyui
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TOKEN=
COMFYUI_TIMEOUT=900

# Perfil de imagen por defecto: fast (Z-Image Turbo) | quality (Qwen-Image 20B) | lite (Z-Image GGUF, 6-8 GB)
GEN_PRESET=fast
GEN_SCALE=1.0

# Z-Image Turbo
GEN_UNET=z_image_turbo_bf16.safetensors
GEN_CLIP=qwen_3_4b.safetensors
GEN_VAE=ae.safetensors
GEN_STEPS=9

# Qwen-Image (calidad máxima; comparte text encoder y VAE con el editor)
QWEN_IMAGE_UNET=qwen_image_fp8_e4m3fn.safetensors
QWEN_IMAGE_LORA=Qwen-Image-Lightning-8steps-V1.0.safetensors
QWEN_IMAGE_STEPS=8

# Qwen-Image-Edit 2509 (ediciones y escenas con modelos del banco)
EDIT_UNET=qwen_image_edit_2509_fp8_e4m3fn.safetensors
EDIT_CLIP=qwen_2.5_vl_7b_fp8_scaled.safetensors
EDIT_VAE=qwen_image_vae.safetensors
EDIT_LORA=Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors
EDIT_STEPS=4

# Video: cinema (Wan 2.2 I2V 14B + 4 pasos, lo mejor en local) | fast (Wan 2.2 TI2V 5B)
VIDEO_PRESET=cinema
VIDEO_SECONDS=5
VIDEO_OUTPUT_FPS=30
VIDEO_CLIP=umt5_xxl_fp8_e4m3fn_scaled.safetensors
VIDEO_HIGH_UNET=wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors
VIDEO_LOW_UNET=wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors
VIDEO_HIGH_LORA=wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors
VIDEO_LOW_LORA=wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors
VIDEO_VAE=wan_2.1_vae.safetensors
VIDEO_FAST_UNET=wan2.2_ti2v_5B_fp16.safetensors
VIDEO_FAST_VAE=wan2.2_vae.safetensors

# ---------- Audio (LOCAL) ----------
# Servidor de voz: python tts_server/server.py
TTS_URL=http://127.0.0.1:8189
# Efectos de sonido (Stable Audio Open en ComfyUI)
SFX_CKPT=stable_audio_open_1.0.safetensors
SFX_CLIP=t5_base.safetensors
SFX_STEPS=50

# ---------- Cadena de producción ----------
QA_MIN_SCORE=70        # nota mínima del juez (por debajo reintenta; nunca borra nada)
QA_MAX_RETRIES=2
WORKERS=8              # trabajos en paralelo (cada GPU dibuja de a uno; los demás esperan su turno)
CONTENT_LANGUAGE=es

# ---------- Publicación (también desde la web: Conexiones) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- App ----------
APP_HOST=127.0.0.1
APP_PORT=8000
# DATA_DIR=./data

# Modelos de OpenRouter para imagen y video. "auto" = Shelton usa el más realista disponible
# (y puede elegir otro según el pedido). Pon un id exacto para fijarlo.
OPENROUTER_IMAGE_MODEL=auto
OPENROUTER_VIDEO_MODEL=auto

# Servidores chicos: cuántos ffmpeg a la vez y qué tan liviano codificar (para que la web no se trabe)
FFMPEG_PARALLEL=1
FFMPEG_PRESET=veryfast

# Dictado por voz: con faster-whisper instalado transcribe en tu servidor (gratis); si no, usa este modelo de OpenRouter
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash
WHISPER_LOCAL=1
WHISPER_MODEL=small

# Shelton mini + scouts revisan la red cada N horas (tendencias, tools y mejor hora para publicar). 0 = apagado
# NETWORK_REVIEW_HOURS=6   (se ajusta en Consumo → Ahorro inteligente; 0 = apagado)
STUDIO_TIMEZONE=America/Argentina/Buenos_Aires

# Generador de voz con OpenRouter (Locutor). auto = el más pro disponible (ElevenLabs v4). Ej: elevenlabs/eleven-v4
OPENROUTER_TTS_MODEL=auto

# 1 = Shelton se abre con link https privado de Tailscale (https://<máquina>.<tu-red>.ts.net). Lo pone el instalador.
SHELTON_HTTPS=0

# Granja de GPUs (ver docs/GRANJA_GPU.md)
# LORA_GPUS=0            # GPUs de la placa que entrenan LoRA (varias: 0,1,2 → una modelo por GPU a la vez)
# LORA_LOCAL_PROFILE=estandar   # estandar (24 GB) o pro (32 GB o más)
