{
  "_doc": "Efectos de sonido y ambientes: Stable Audio Open 1.0 (motor de auto, moto, olas, ciudad, música corta). Nativo en ComfyUI.",
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "{{ckpt}}"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "{{clip}}", "type": "stable_audio", "device": "default"}},
  "3": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "{{prompt}}"}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "{{negative}}"}},
  "5": {"class_type": "ConditioningStableAudio", "inputs": {"positive": ["3", 0], "negative": ["4", 0],
        "seconds_start": 0.0, "seconds_total": "{{seconds}}"}},
  "6": {"class_type": "EmptyLatentAudio", "inputs": {"seconds": "{{seconds}}", "batch_size": 1}},
  "7": {"class_type": "KSampler", "inputs": {"model": ["1", 0], "positive": ["5", 0], "negative": ["5", 1],
        "latent_image": ["6", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": 5.0,
        "sampler_name": "dpmpp_3m_sde_gpu", "scheduler": "exponential", "denoise": 1.0}},
  "8": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["7", 0], "vae": ["1", 2]}},
  "9": {"class_type": "SaveAudio", "inputs": {"audio": ["8", 0], "filename_prefix": "shelton/sfx"}}
}
